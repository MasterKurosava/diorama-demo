---
// The landscape and its work pages. One script for all of them, so it runs once per visit and
// the canvas, Lenis and the page state live across navigations.
import { ClientRouter } from 'astro:transitions'
import Cover from '../cover/Cover.astro'
import Small from '../small/Small.astro'
import 'lenis/dist/lenis.css'
import '../landing/style.css'
import '../landing/cursor.css'
import '../landing/ghost.css'
import '../landing/chapters/chapters.css'
import '../landing/chapters/why.css'
import '../landing/chapters/map.css'
import '../landing/chapters/layout.css'
import '../landing/chapters/night.css'
import '../landing/chapters/lantern.css'
import '../landing/chapters/editor.css'
import '../landing/chapters/dawn.css'
import '../landing/chapters/catalogue.css'
import '../landing/chapters/build.css'

interface Props {
  title: string
  /** A work page: the paper sheet is up. */
  work?: boolean
  /** Dark paper. */
  night?: boolean
}

const { title, work = false, night = false } = Astro.props
---

<html lang="en" class:list={{ 'on-work': work, 'night-page': night }} data-lenis>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Diorama puts three.js effects on ordinary HTML: one attribute on any element."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      /* Critical CSS for the first paint. */
      @font-face {
        font-family: Archivo;
        src: url("/fonts/archivo.woff2") format("woff2");
        font-weight: 100 900;
        font-stretch: 62% 125%;
        font-display: swap;
      }
      @font-face {
        font-family: "JetBrains Mono";
        src: url("/fonts/jetbrains-mono.woff2") format("woff2");
        font-weight: 100 800;
        font-display: swap;
      }
      :root {
        --wall: #4b1519;
        --cream: #f3e9d8;
        --edge: clamp(20px, 6vw, 96px);
        background: var(--wall);
        color: var(--cream);
        font: 400 17px / 1.55 Archivo, system-ui, sans-serif;
      }
      body {
        margin: 0;
      }
      .top {
        position: fixed;
        inset: 0 0 auto;
        z-index: 10;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding: 24px var(--edge);
      }
      .mark {
        font-weight: 800;
        font-stretch: 125%;
        font-size: 15px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: inherit;
        text-decoration: none;
      }
      .on-work {
        color: var(--wall);
      }
    </style>
    <ClientRouter />
  </head>
  <body>
    <Small />
    <slot name="before" />
    <div class="sheet" aria-hidden="true"></div>
    <div id="page">
      <slot />

      <footer class="foot">
        <p>Diorama is MIT.</p>
      </footer>
    </div>
    <Cover />
    <div class="cursor" aria-hidden="true" transition:persist="cursor">
      <i class="cursor-ring"></i><i class="cursor-dot"></i>
      <span class="cursor-disc"><span class="cursor-text"></span></span>
    </div>

    <script>
      import '../cover/cover'
      import '../landing/main'
    </script>
  </body>
</html>
