        <section class="hero" aria-labelledby="title">
          <div class="dusk" aria-hidden="true"></div>
          <div class="hero-pin" data-dio="scene">
            <div class="hero-copy">
              <h1 id="title" class="hero-title" data-dio="title">
                <span class="line">WebGL effects</span>
                <span class="line">for plain</span>
                <span class="line deep">HTML.</span>
              </h1>
              <div class="hero-words">
                <p class="hero-lede">One attribute on any element.<span class="lede-more"> Built on three.js, drawn with WebGPU.</span></p>
                <p class="hero-actions">
                  <a class="button solid" href="/docs/start">Get started</a>
                  <button class="install" type="button" data-copy="npm i @dioramajs/diorama three" title="Copy">
                    <code>npm i @dioramajs/diorama three</code><span class="install-done" aria-live="polite"></span>
                  </button>
                </p>
              </div>
            </div>

            <figure class="piece piece-photo">
              <img src="/media/ridges.jpg" width="1800" height="1200" alt="Mountain ridges fading into the haze one behind another" data-dio="image photo" />
              <figcaption class="whisper">data-dio="image photo"</figcaption>
            </figure>
            <figure class="piece piece-portrait">
              <img src="/media/watcher.jpg" width="900" height="1200" alt="A woman on a hill watching the city at dusk" data-dio="grains" />
              <figcaption class="whisper">data-dio="grains"</figcaption>
            </figure>
            <figure class="piece piece-metal">
              <div class="metal" data-dio="metal" role="img" aria-label="A drop of liquid metal"></div>
              <figcaption class="whisper">data-dio="metal"</figcaption>
            </figure>

            <div class="chapter" inert>
              <a class="landing" href="/work/ridges" tabindex="-1" aria-hidden="true" aria-label="Ridges">
                <img src="/media/ridges.jpg" width="1800" height="1200" alt="" data-dio="shadowbox" data-dio-key="ridges" />
              </a>
              <div class="label">
                <p class="label-kicker">Page transitions</p>
                <h2 class="label-title">The picture flies to&nbsp;its&nbsp;page.</h2>
                <p class="label-text">
                  One <code>data-dio-key</code> on both pages: the picture itself flies to the next one.
                </p>
                <a class="label-go" href="/work/ridges">Follow the picture <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>
        </section>
