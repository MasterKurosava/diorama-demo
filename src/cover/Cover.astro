---
import { ridges } from '../landing/ridges'

// The torn top edge of the site's paper sheets, as a mask so the sheet's colour shows through.
const edge = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 80' preserveAspectRatio='none'><path d='${ridges.edge}'/></svg>`,
)}")`
// The loader's ridges, cropped to their lower half: a small diorama along the foot of the sheet.
const land = [ridges.far, ridges.mid, ridges.near]
---

<div id="passage" class="passage" aria-hidden="true" data-tone="paper" transition:persist="passage">
  <div class="passage-sheet" style={`--edge-mask: ${edge}`}>
    <div class="passage-head">
      <span class="passage-mark">Diorama</span>
      <span class="passage-path"></span>
    </div>
    <div class="passage-land">
      {
        land.map((d) => (
          <div class="passage-ridge">
            <svg viewBox="0 500 1440 500" preserveAspectRatio="none">
              <path d={d} />
            </svg>
          </div>
        ))
      }
    </div>
    <div class="passage-title">
      <p class="passage-where"><span>Docs</span></p>
      <p class="passage-what"></p>
      <span class="passage-line"><i></i></span>
    </div>
  </div>
</div>

<style is:global>
  /* A sheet of paper that covers a slow page change, in the colour of the page being opened: its
     name above a small diorama of paper ridges. It slides up with a torn edge, holds while the
     page loads and lifts off. Everything that moves while it waits is transform or opacity. */
  .passage {
    --passage-bg: #f3e9d8;
    --passage-sky: #f3e9d8;
    --passage-ink: #4b1519;
    --passage-r1: #e7d3ba;
    --passage-r2: #d9b9a1;
    --passage-r3: #c4977f;
    --passage-edge: clamp(20px, 6vw, 96px);
    --passage-land: clamp(150px, 32vh, 340px);
    --passage-arrive: cubic-bezier(0.16, 1, 0.3, 1);
    position: fixed;
    inset: 0;
    z-index: 90;
    visibility: hidden;
    pointer-events: none;
    font-family: Archivo, system-ui, sans-serif;
  }
  .passage[data-tone="dusk"] {
    --passage-bg: #4b1519;
    --passage-sky: #2c0b10;
    --passage-ink: #f3e9d8;
    --passage-r1: #86393b;
    --passage-r2: #5a1b1f;
    --passage-r3: #3d1014;
  }
  .passage[data-tone="night"] {
    --passage-bg: #0b0a20;
    --passage-sky: #0b0a20;
    --passage-ink: #f3e9d8;
    --passage-r1: #2a1d44;
    --passage-r2: #1d1433;
    --passage-r3: #130d25;
  }
  .passage.on {
    visibility: visible;
  }
  /* The page darkens in the shadow of the sheet. */
  .passage::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgb(20 4 5 / 0.45);
    opacity: 0;
  }
  .passage.on::before {
    opacity: 1;
    transition: opacity 0.5s;
  }
  .passage.out::before {
    opacity: 0;
    transition-duration: 0.35s;
  }
  .passage-sheet {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--passage-sky), var(--passage-bg) 70%);
    color: var(--passage-ink);
    translate: 0 calc(100% + 12vh);
    will-change: translate;
  }
  .passage-sheet::before,
  .passage-sheet::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    height: 12vh;
    mask: var(--edge-mask) 0 100% / 100% 100% no-repeat;
  }
  .passage-sheet::before {
    bottom: calc(100% - 1px);
    background: var(--passage-sky);
  }
  .passage-sheet::after {
    top: calc(100% - 1px);
    background: var(--passage-r3);
    scale: 1 -1;
  }
  .passage.on .passage-sheet {
    translate: none;
    transition: translate 0.75s var(--passage-arrive);
  }
  .passage.out .passage-sheet {
    translate: 0 calc(-100% - 12vh);
    transition: translate 0.6s cubic-bezier(0.7, 0, 0.84, 0);
  }
  .passage-head {
    position: absolute;
    inset: 24px var(--passage-edge) auto;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
  }
  .passage-mark {
    font-weight: 800;
    font-stretch: 125%;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .passage-path {
    font: 500 12px / 1 "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: 0.04em;
    opacity: 0.72;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Three ridges, wider than the screen so they can drift apart while the page loads. */
  .passage-land {
    position: absolute;
    inset: auto 0 0;
    height: var(--passage-land);
  }
  .passage-ridge {
    position: absolute;
    inset: 0 -3%;
    translate: 0 70%;
  }
  .passage-ridge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .passage-ridge:nth-child(1) path {
    fill: var(--passage-r1);
  }
  .passage-ridge:nth-child(2) path {
    fill: var(--passage-r2);
  }
  .passage-ridge:nth-child(3) path {
    fill: var(--passage-r3);
  }
  .passage.on .passage-ridge {
    translate: none;
    transition: translate 1.1s var(--passage-arrive);
    animation: passage-drift 7s ease-in-out infinite alternate;
  }
  .passage.on .passage-ridge:nth-child(1) {
    transition-delay: 0.12s;
    --drift: 1.2%;
  }
  .passage.on .passage-ridge:nth-child(2) {
    transition-delay: 0.2s;
    --drift: -1.8%;
  }
  .passage.on .passage-ridge:nth-child(3) {
    transition-delay: 0.28s;
    --drift: 2.6%;
  }
  @keyframes passage-drift {
    to {
      transform: translateX(var(--drift, 0));
    }
  }
  .passage-title {
    position: absolute;
    left: var(--passage-edge);
    right: var(--passage-edge);
    bottom: calc(var(--passage-land) + 7vh);
  }
  .passage-where,
  .passage-what {
    margin: 0;
  }
  .passage-where {
    overflow: hidden;
    padding-bottom: 0.08em;
    font-weight: 800;
    font-stretch: 112%;
    font-size: clamp(40px, 8.5vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .passage-where span {
    display: block;
    translate: 0 105%;
  }
  .passage.on .passage-where span {
    translate: none;
    transition: translate 0.8s var(--passage-arrive) 0.12s;
  }
  .passage-what {
    max-width: 40ch;
    margin-top: 12px;
    font-weight: 500;
    font-size: 17px;
    line-height: 1.4;
    opacity: 0;
  }
  .passage.on .passage-what {
    opacity: 0.82;
    transition: opacity 0.5s 0.3s;
  }
  .passage-what:empty {
    display: none;
  }
  .passage-line {
    display: block;
    width: min(260px, 60%);
    height: 1px;
    margin-top: 22px;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 22%, transparent);
  }
  .passage-line i {
    display: block;
    height: 100%;
    background: currentColor;
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  /* Nothing tells how far the next page is, so the line sweeps until it is there. */
  .passage.on .passage-line i {
    animation: passage-wait 1.5s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  .passage.done .passage-line i {
    animation: none;
    transform: none;
    transition: transform 0.25s;
  }
  @keyframes passage-wait {
    from {
      transform: translateX(-35%) scaleX(0.35);
    }
    to {
      transform: translateX(100%) scaleX(0.35);
    }
  }
  /* Under the sheet the new page replaces the old one at once. */
  html[data-covered]::view-transition-old(*),
  html[data-covered]::view-transition-new(*) {
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .passage-sheet,
    .passage.on .passage-sheet,
    .passage.out .passage-sheet {
      translate: none;
      opacity: 0;
      transition: opacity 0.25s;
    }
    .passage.on .passage-sheet {
      opacity: 1;
    }
    .passage.out .passage-sheet {
      opacity: 0;
    }
    .passage-ridge,
    .passage.on .passage-ridge,
    .passage-where span,
    .passage.on .passage-where span {
      translate: none;
      transition: none;
      animation: none;
    }
    .passage.on .passage-line i {
      animation: none;
      transform: scaleX(0.5);
    }
  }
</style>
