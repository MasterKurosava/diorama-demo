---
// The note for phones and narrow windows (small.ts): a still dusk over the loader's paper ridges,
// and a way to take the address to a bigger screen. Hidden everywhere else; where it shows, the
// rest of the page is hidden.
import { ridges } from '../landing/ridges'
---

<style is:inline>
  .small {
    display: none;
  }
  /* The query of small.ts. */
  @media (max-width: 767px), (pointer: coarse) and (max-height: 500px) {
    html {
      overflow: hidden;
      background: #4b1519;
    }
    body > :not(.small) {
      display: none !important;
    }
    .small {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: grid;
      grid-template-rows: auto 1fr;
      overflow: hidden;
      padding: 22px clamp(22px, 7vw, 48px);
      background:
        radial-gradient(ellipse 70% 32% at 78% 34%, rgb(255 222 180 / 0.45), transparent 70%),
        linear-gradient(to bottom, #4b1519 0%, #7a3330 30%, #e39a76 50%, #a85c58 58%, #6d282b 70%, #4b1519 100%);
      color: #f3e9d8;
      font: 400 16px / 1.55 Archivo, system-ui, sans-serif;
    }
  }
  .small-sun {
    position: absolute;
    top: 30%;
    left: 78%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff7ea 0 52%, rgb(255 236 210 / 0.6) 60%, transparent 72%);
    box-shadow: 0 0 80px 30px rgb(255 214 170 / 0.35);
  }
  .small-ridges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .small-ridges path {
    filter: drop-shadow(0 -6px 10px rgb(40 8 12 / 0.35));
  }
  .small-mark {
    position: relative;
    margin: 0;
    font-weight: 800;
    font-stretch: 125%;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .small-body {
    position: relative;
    align-self: end;
    max-width: 30rem;
    padding-bottom: clamp(20px, 6vh, 56px);
  }
  .small-title {
    margin: 0;
    font-size: clamp(2.3rem, 11vw, 3.2rem);
    font-weight: 800;
    font-stretch: 112%;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .small-text {
    max-width: 26em;
    margin: 18px 0 0;
    color: rgb(243 233 216 / 0.86);
    text-wrap: pretty;
  }
  .small-text .narrow {
    display: none;
  }
  /* A mouse in a narrow window: the window can grow. */
  @media (pointer: fine) {
    .small-text .phone {
      display: none;
    }
    .small-text .narrow {
      display: inline;
    }
  }
  .small-text b {
    font: 500 0.94em "JetBrains Mono", monospace;
    color: #fff2df;
  }
  .small-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 26px 0 0;
  }
  .small-actions > * {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    padding: 0 22px;
    border: 1px solid rgb(243 233 216 / 0.5);
    border-radius: 999px;
    background: rgb(40 8 10 / 0.3);
    color: #f3e9d8;
    font: 600 15px Archivo, system-ui, sans-serif;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .small-copy {
    border-color: #f3e9d8;
    background: #f3e9d8;
    color: #2a1715;
    cursor: pointer;
  }
  .small-copy .done,
  .small-copy[data-done] .idle {
    display: none;
  }
  .small-copy[data-done] .done {
    display: inline;
  }
  .small-actions > :focus-visible {
    outline: 2px solid #ffcf98;
    outline-offset: 3px;
  }
</style>

<section class="small" aria-labelledby="small-title">
  <i class="small-sun" aria-hidden="true"></i>
  <svg class="small-ridges" viewBox="0 0 1440 1000" preserveAspectRatio="none" aria-hidden="true">
    <path fill="#a85c58" d={ridges.far}></path>
    <path fill="#86393b" d={ridges.mid}></path>
    <path fill="#5a1b1f" d={ridges.near}></path>
    <path fill="#3d1014" d={ridges.front}></path>
  </svg>
  <p class="small-mark">Diorama</p>
  <div class="small-body">
    <p class="small-title" id="small-title">Made for a big&nbsp;screen.</p>
    <p class="small-text" id="small-text">
      <span class="phone">This site is one 3D scene, built for a computer: a wide window and a mouse. Open <b>dioramajs.dev</b> on a desktop or a laptop to see it.</span>
      <span class="narrow">This site is one 3D scene, built for a wide window. Make this one wider, or open <b>dioramajs.dev</b> on a larger screen.</span>
    </p>
    <p class="small-actions">
      <button class="small-copy" type="button"><span class="idle">Copy the link</span><span class="done">Copied</span></button>
      <a href="https://github.com/MasterKurosava/diorama">GitHub</a>
    </p>
  </div>
</section>
